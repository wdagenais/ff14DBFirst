@model BDFirstFF14.Models.InscriptionVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<hr />
<div class="row">

    <div class="col-4">


    </div>


    <div class="col-md-4 align-content-center">
        <form asp-action="Inscription" asp-controller="Clients" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nom" class="control-label"></label>
                <input asp-for="Nom" class="form-control"></input>
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Prenom" class="control-label"></label>
                <input asp-for="Prenom" class="form-control"></input>
                <span asp-validation-for="Prenom" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Courriel" class="control-label"></label>
                <input asp-for="Courriel" class="form-control"></input>
                <span asp-validation-for="Courriel" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MotDePasse" class="control-label"></label>
                <input asp-for="MotDePasse" class="form-control" type="password"></input>
                <span asp-validation-for="MotDePasse" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="ConfirmMotDePasse" class="control-label"></label>
                <input asp-for="ConfirmMotDePasse" class="form-control" type="password"></input>
                <span asp-validation-for="ConfirmMotDePasse" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input style="margin-top:12px" type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
        </div>

        <div class="col-4">
        </div>
        </div>

        <div class="row">
    <div class="col-7">
    </div>

     <div class="col-3">
        <a  href="@Url.Action("Index", "Personnages")">Back to List</a>
    </div>

    <div class="col-2">
    </div>

        </div>

        

        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
        }
