@model BDFirstFF14.Models.ConnexionVM


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<hr />
<a class="row">
    <div class="col-md-12">
        <form asp-action="Connexion" asp-controller="Clients" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Courriel" class="control-label"></label>
                <input asp-for="Courriel" class="form-control"></input>
                <span asp-validation-for="Courriel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MotDePasse" class="control-label"></label>
                <input asp-for="MotDePasse" class="form-control" type="password"></input>
                <span asp-validation-for="MotDePasse" class="text-danger"></span>
            </div>
        <div class="form-group" style="margin-top: 30px;">
            <button type="submit" class="btnIndex">Log in</button>
           
        </div>
        </form>
        </div>
        <div class="col-4">
        <a href="@Url.Action("Index","Personnages")">Page d'accueil</a>
        </div>
    
            @section Scripts {
                @{
                    await Html.RenderPartialAsync("_ValidationScriptsPartial");
                }
            }
