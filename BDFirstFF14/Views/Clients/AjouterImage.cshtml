@model BDFirstFF14.ViewModel.ImageUploadVM

@{
    ViewData["Title"] = "AjouterImage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>AjouterImage</h1>

<h4>ImageUploadVM</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AjouterImage">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="NomImage" class="control-label"></label>
                <input asp-for="NomImage" class="form-control" />
                <span asp-validation-for="NomImage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
