@model BDFirstFF14.ViewModel.ImageUploadVM

@{
    ViewData["Title"] = "AjouterImage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>AjouterImage</h1>

<h4>ImageUploadVM</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="AjouterImage" enctype="multipart/form-data">
            <input type="hidden" asp-for="PersonnageId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="NomImage" class="control-label"></label>
                <input asp-for="NomImage" class="form-control" />
                <span asp-validation-for="NomImage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>

            <div class="form-group">
                <!-- Ajouter un input pour le fichier image ici -->
                <label for="FormFile">Fichier image: </label>
                <input id="FormFile" name="FormFile" type="file" accept="image/*" class="form-control-file" />
                <span asp-validation-for="FormFile" class="text-danger"></span>
            </div>

        </form>
    </div>
</div>


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
